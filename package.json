{
  "name": "raindrops-on-roses-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/pure/*/*",
    "packages/composed/*/*",
    "packages/raindrops-on-roses"
  ],
  "scripts": {

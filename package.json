{
  "name": "raindrops-on-roses-monorepo",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "assemble": "node scripts/assemble.mjs",
    "refresh": "npm run assemble && npm install && npm run build",
    "add:function": "node scripts/droplet.mjs",
    "build": "node scripts/build.mjs",
    "test": "vitest run",
    "test:w": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "oxlint .",
    "lint:fix": "oxlint . --fix",
    "typecheck": "tsc -p tsconfig.typecheck.json --noEmit",
    "check": "npm run lint && npm run test && npm run build && npm run typecheck",
    "bootstrap": "node scripts/bootstrap.mjs",
    "bootstrap:dry": "node scripts/bootstrap.mjs --dry-run",
    "release": "node scripts/release.mjs",
    "publish:packages": "node scripts/publish.mjs"
  },
  "devDependencies": {
    "@e18e/eslint-plugin": "^0.8.1",
    "@types/node": "^22.20.3",
    "@vitest/coverage-v8": "^5.0.1",
    "oxlint": "^1.83.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.0",
    "vitest": "^5.0.1"
  }
}
